print("My birthday:", my_birthday)

import datetime

# Example: Calculate days until an event
event_date = datetime.date(2025, 1, 1)  # Set an event date
today = datetime.date.today()  # Get today's date
days_until_event = (event_date - today).days

print(f"There are {days_until_event} days left until the event.")
