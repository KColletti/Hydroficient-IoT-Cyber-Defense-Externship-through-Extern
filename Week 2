# DATA STRUCTURE: List of sensor readings (dictionaries)
sensor_data = [
    {"device_id": "GM-HYDROLOGIC-01", "flow_rate": 41.2},
    {"device_id": "GM-HYDROLOGIC-02", "flow_rate": 95.2},
    {"device_id": "GM-HYDROLOGIC-03", "flow_rate": 42.0},
]

# FUNCTION: Reusable leak detection
def is_leak(flow_rate):
    return flow_rate > 80

# CONTROL FLOW: Loop through and make decisions
for reading in sensor_data:
    device = reading["device_id"]
    flow = reading["flow_rate"]

    if is_leak(flow):
        print(f"⚠️ {device}: Leak detected!")
    else:
        print(f"✓ {device}: Normal")

